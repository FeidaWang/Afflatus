# Server-side only. Never prefix secrets with VITE_ or put them in public/.
VIBE_BRIDGE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
VIBE_UPSTREAM_AGENT=/absolute/path/to/vendor/vibe-trading/agent
# No broker / LLM credentials are required for the included read-only bridge.
# SEC filing/fact/13F/N-PORT adapters require a real operator name and email:
# VIBE_TRADING_SEC_UA=Operator organisation contact@your-domain
# Leave unset until an actual contact is supplied; example.com is rejected.
