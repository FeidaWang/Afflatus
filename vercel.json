{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.feida.au" }],
      "destination": "https://feida.au/:path*",
      "permanent": true
    },
    {
      "source": "/en/serial.html",
      "destination": "/zh/serial.html",
      "permanent": true
    },
    {
      "source": "/novels",
      "destination": "/serial.html",
      "permanent": true
    },
    {
      "source": "/novels/",
      "destination": "/serial.html",
      "permanent": true
    },
    {
      "source": "/zh/novels",
      "destination": "/zh/serial.html",
      "permanent": true
    },
    {
      "source": "/zh/novels/",
      "destination": "/zh/serial.html",
      "permanent": true
    },
    {
      "source": "/en/novels/:book",
      "destination": "/zh/novels/:book",
      "permanent": true
    },
    {
      "source": "/en/novels/:book/",
      "destination": "/zh/novels/:book/",
      "permanent": true
    },
    {
      "source": "/en/novels/:book/:chapter",
      "destination": "/zh/novels/:book/:chapter",
      "permanent": true
    },
    {
      "source": "/en/novels/:book/:chapter/",
      "destination": "/zh/novels/:book/:chapter/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; worker-src 'self' blob:; frame-src 'self'; media-src 'self' blob:" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/assets/(.+-[A-Za-z0-9_-]{8}\\.(?:js|css))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ],
  "functions": {
    "api/vibe-model.py": {
      "maxDuration": 30,
      "includeFiles": "{services/vibe-model/**,services/vibe-bridge/bridge/**}",
      "excludeFiles": "{node_modules/**,dist/**,public/**,prototypes/**,content/**,data/**,.git/**,.github/**,artifacts/**,src/**,scripts/**,assets/**,api/*.js,*.html,*.md,*.mjs,*.cjs,*.js,*.command}"
    },
    "api/arena-fsi.mjs": {
      "maxDuration": 180
    }
  }
}
