{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.feida.au" }],
      "destination": "https://feida.au/:path*",
      "permanent": true
    },
    {
      "source": "/league.html",
      "destination": "/stats.html",
      "permanent": true
    },
    {
      "source": "/games.html",
      "destination": "/stats.html",
      "permanent": true
    },
    {
      "source": "/en/league.html",
      "destination": "/en/stats.html",
      "permanent": true
    },
    {
      "source": "/zh/league.html",
      "destination": "/zh/stats.html",
      "permanent": true
    },
    {
      "source": "/en/games.html",
      "destination": "/en/stats.html",
      "permanent": true
    },
    {
      "source": "/zh/games.html",
      "destination": "/zh/stats.html",
      "permanent": true
    },
    {
      "source": "/en/serial.html",
      "destination": "/zh/serial.html",
      "permanent": true
    },
    {
      "source": "/novels",
      "destination": "/serial.html",
      "permanent": true
    },
    {
      "source": "/novels/",
      "destination": "/serial.html",
      "permanent": true
    },
    {
      "source": "/zh/novels",
      "destination": "/zh/serial.html",
      "permanent": true
    },
    {
      "source": "/zh/novels/",
      "destination": "/zh/serial.html",
      "permanent": true
    },
    {
      "source": "/en/novels/:book",
      "destination": "/zh/novels/:book",
      "permanent": true
    },
    {
      "source": "/en/novels/:book/",
      "destination": "/zh/novels/:book/",
      "permanent": true
    },
    {
      "source": "/en/novels/:book/:chapter",
      "destination": "/zh/novels/:book/:chapter",
      "permanent": true
    },
    {
      "source": "/en/novels/:book/:chapter/",
      "destination": "/zh/novels/:book/:chapter/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/portal",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'self' blob:; form-action 'none'; base-uri 'none'; frame-ancestors 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/portal/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'self' blob:; form-action 'none'; base-uri 'none'; frame-ancestors 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/portal/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/portal/ocr/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
