{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.feida.au" }],
      "destination": "https://feida.au/:path*",
      "permanent": true
    },
    {
      "source": "/en/serial.html",
      "destination": "/zh/serial.html",
      "permanent": true
    },
    {
      "source": "/novels",
      "destination": "/serial.html",
      "permanent": true
    },
    {
      "source": "/novels/",
      "destination": "/serial.html",
      "permanent": true
    },
    {
      "source": "/zh/novels",
      "destination": "/zh/serial.html",
      "permanent": true
    },
    {
      "source": "/zh/novels/",
      "destination": "/zh/serial.html",
      "permanent": true
    },
    {
      "source": "/en/novels/:book",
      "destination": "/zh/novels/:book",
      "permanent": true
    },
    {
      "source": "/en/novels/:book/",
      "destination": "/zh/novels/:book/",
      "permanent": true
    },
    {
      "source": "/en/novels/:book/:chapter",
      "destination": "/zh/novels/:book/:chapter",
      "permanent": true
    },
    {
      "source": "/en/novels/:book/:chapter/",
      "destination": "/zh/novels/:book/:chapter/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://gol.gg https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; worker-src 'self' blob:; frame-src 'self'; media-src 'self' blob:" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
