# Deploy-time ignore: only what the build and the Python function do not need.
# Build inputs (scripts/, src/, content/, public/, assets/, services/, api/) stay.
docs/
rfcs/
prompts/
assets-archive/
data-archive/
dist_*/
e2e/
tests/
integrations/*
# Arena FSI: the arena.html UI (build) and /api/arena-fsi (runtime) import only these paths.
!integrations/arena-fsi/
integrations/arena-fsi/*
!integrations/arena-fsi/server/
!integrations/arena-fsi/src/
!integrations/arena-fsi/ui/
integrations/arena-fsi/ui/*
!integrations/arena-fsi/ui/ArenaFsi.jsx
!integrations/arena-fsi/ui/styles.css
output/
tools/
