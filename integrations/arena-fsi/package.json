{
  "name": "afflatus-arena-fsi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test && npm run build",
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.config.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "install:host": "node scripts/install-host.mjs",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "jsdom": "30.1.1",
    "vite": "8.0.14"
  }
}
