# Local demonstration is explicit. In Vercel set ARENA_MODE=live.
ARENA_MODE=demo
ARENA_ADMIN_TOKEN=
CRON_SECRET=
DATABASE_URL=
ARENA_PUBLIC_QUOTES=false
ARENA_AUTORUN=false
ARENA_INITIAL_CASH=10000
ARENA_WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,MU,AVGO,SPY,SMH
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# iex is one exchange; sip requires appropriate entitlement; delayed_sip never fills.
ALPACA_DATA_FEED=iex
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Explicit model IDs; empty means unconfigured. No guessed current model aliases.
ARENA_S_PROVIDER=anthropic
ARENA_S_MODEL=
ARENA_P_PROVIDER=openai
ARENA_P_MODEL=
ARENA_T_PROVIDER=anthropic
ARENA_T_MODEL=
ARENA_MAX_RUNS_PER_DAY=6
ARENA_MAX_OUTPUT_TOKENS=1800

