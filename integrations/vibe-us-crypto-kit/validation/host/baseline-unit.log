+         (bm && bm.chapterId === c.id ? ' <span class="bk">☆</span>' : '') + '</span>';
+       b.addEventListener('click', function (event) {
+         if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+         event.preventDefault();
