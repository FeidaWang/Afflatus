+     if (mode === 'none') return;
+     var locale = serialApi.readerLocale(
+       location.pathname,
+       document.documentElement.dataset.afflatusLocale
+     );
+     var path = serialApi.readerPath({ locale:locale, bookId:state.novelId, chapterId:chapterId });
