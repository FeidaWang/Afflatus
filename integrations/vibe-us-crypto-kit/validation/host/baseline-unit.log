+     function syncUi(playing) {
+       btnPlay.textContent = playing ? '❚❚' : '♪';
+       btnPlay.classList.toggle('active', !!playing);
+       var t = tracks[idx];
+       var label = t ? (t.title + (t.artist ? ' — ' + t.artist : '')) : '伴读音乐';
+       btnPlay.title = '♪ ' + label;
+       btnPlay.setAttribute('aria-label', (playing ? T('Pause: ', '暂停：') : T('Play: ', '播放：')) + label);
+     }
