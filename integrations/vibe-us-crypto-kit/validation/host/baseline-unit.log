+     function load(i) {
+       idx = (i + tracks.length) % tracks.length;
+       var t = tracks[idx], url = pickUrl(t);
+       if (!url) { skipBad(); return false; }
+       audio.src = url;
+       setMediaSession(t);
+       if (readerStore) readerStore.setAudioTrack(idx);
+       syncUi(!audio.paused && !audio.ended);
+       return true;
+     }
