{
  "name": "project-afflatus",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run data:check && npm run site:check && npm run header:check && npm run css:check && npm run combat:asset:check && npm run lint:i18n && npm run og:check",
    "build": "vite build && node scripts/localize-site.mjs --out-dir dist && node scripts/validate-emitted-seo.mjs --out-dir dist",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/quality-gates.spec.js",
    "test:e2e:visual": "playwright test e2e/visual-captures.spec.js e2e/combat-hud.visual.spec.js",
    "test:e2e:report": "playwright show-report",
    "pretest:lighthouse": "npm run build",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "lighthouse:ci": "node scripts/run-lighthouse.mjs",
    "typecheck": "tsc --noEmit",
    "data:check": "node scripts/validate-data.mjs",
    "data:freshness": "node scripts/check-data-freshness.mjs",
    "data:freshness:strict": "node scripts/check-data-freshness.mjs --strict",
    "data:publish": "node scripts/publish-data-pipeline.mjs",
    "data:arena:catchup": "node scripts/catch-up-arena.mjs",
    "site:generate": "node scripts/site-manifest.mjs --write",
    "site:check": "node scripts/site-manifest.mjs --check",
    "header:audit": "node scripts/audit-header.mjs",
    "header:check": "node scripts/audit-header.mjs --check",
    "css:check": "node scripts/check-no-new-important.mjs && node scripts/check-css-architecture.mjs",
    "combat:asset:build": "node scripts/build-combat-glb.mjs",
    "combat:models:build": "node scripts/build-combat-cic-lod.mjs",
    "combat:textures:build": "node scripts/build-vanguard-textures.mjs",
    "combat:asset:check": "node scripts/check-combat-glb.mjs",
    "seo:check": "node scripts/validate-emitted-seo.mjs --out-dir dist",
    "og:generate": "node scripts/generate-og-assets.mjs",
    "og:check": "node scripts/validate-og-assets.mjs",
    "lint:i18n": "node scripts/lint-bilingual.mjs",
    "format:i18n": "node scripts/format-bilingual-content.mjs --write",
    "linkcheck": "npm run build && linkinator dist --recurse --silent --skip \"googletagmanager.com|fonts.gstatic.com|fonts.googleapis.com|twelvedata.com|feida.au\""
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "three": "^0.160.1",
    "web-vitals": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.160.0",
    "linkinator": "^8.0.3",
    "parse5": "^8.0.0",
    "postcss": "^8.5.15",
    "typescript": "^5.7.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
